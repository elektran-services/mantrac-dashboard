# GPS51 API Configuration
NEXT_PUBLIC_GPS51_API_URL=https://api.gps51.com/openapi
NEXT_PUBLIC_GPS51_SERVER_ID=2

# HERE Maps API Configuration (for reverse geocoding)
NEXT_PUBLIC_HERE_API_KEY=your-here-api-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME=Mantrac Dashboard
NEXT_PUBLIC_APP_VERSION=1.0.0

# Session Configuration (in milliseconds)
SESSION_TIMEOUT=3600000

# Do not set NODE_ENV in env files used for production builds — it can break prerender.
# Next.js sets NODE_ENV automatically for dev, build, and start.

# Monitoring Service Credentials (optional - will prompt if not set)
# To get your token, login to GPS51 and check your auth token
MONITOR_USERNAME=your-username-here
MONITOR_TOKEN=your-auth-token-here

# Email Configuration for Overspeed Reports
# Enable/disable email sending (true/false)
ENABLE_EMAIL_REPORTS=false

# SMTP Configuration
# For Gmail: smtp.gmail.com, port 587, use app password (not regular password)
# For Outlook: smtp-mail.outlook.com, port 587
# For custom SMTP: contact your IT department for details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password

# Email Recipients (comma-separated for multiple addresses)
EMAIL_TO=recipient1@example.com,recipient2@example.com
EMAIL_FROM=alerts@example.com
EMAIL_SUBJECT=Overspeed Alert - Violations Detected
