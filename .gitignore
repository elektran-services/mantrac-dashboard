# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated report exports (retained on disk up to 365 days; do not commit binaries)
/generated_reports/*
!/generated_reports/.gitkeep

# daily all-device trip exports
/trips/*
!/trips/.gitkeep

# scheduled mileage reports
/mileage_report/*
!/mileage_report/.gitkeep
/mileage_overall_report/*
!/mileage_overall_report/.gitkeep

# offline / parking report exports (keep folder, not binaries)
/offline_reports/*
!/offline_reports/.gitkeep
/parking_reports/*
!/parking_reports/.gitkeep

# runtime logs
/logs/

# Excel lock files
~$*
